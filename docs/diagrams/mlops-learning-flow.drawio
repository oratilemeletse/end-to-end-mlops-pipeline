<mxfile host="app.diagrams.net" modified="2026-08-16T21:25:00.000Z" agent="GitHub Copilot CLI" version="24.7.17">
  <diagram id="mlops-learning-flow" name="MLOps Learning Flow">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Our MLOps Project: From Raw Data to a Deployed Model" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="320" y="30" width="760" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Blue = completed so far &amp;nbsp; | &amp;nbsp; Orange = next step &amp;nbsp; | &amp;nbsp; Gray = later phases" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontSize=14;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="380" y="75" width="640" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="source" value="1. Official UCI Website&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Public Bank Marketing dataset&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="download" value="2. Verified Download Script&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;scripts\download_bank_marketing.py&lt;br&gt;Checks source, checksum and shape&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="160" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="raw" value="3. Original Data&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;data\raw\bank-additional-full.csv&lt;br&gt;41,188 rows × 21 columns&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="160" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="prepare" value="4. Data Preparation&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;src\prepare_data.py&lt;br&gt;Validates data, removes duration leakage,&lt;br&gt;then makes a repeatable 80/20 split&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="150" width="300" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="train-data" value="Training Data&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;artifacts\prepared\train.csv&lt;br&gt;32,950 rows&lt;br&gt;Used to teach the model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="360" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="test-data" value="Test Data&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;artifacts\prepared\test.csv&lt;br&gt;8,238 rows&lt;br&gt;Kept untouched for evaluation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="360" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="train-model" value="5. Train the Model — NEXT&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Learn patterns from numeric and categorical columns&lt;br&gt;Save a reusable MLflow model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="675" y="550" width="320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="evaluate" value="6. Evaluate the Model&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Use only the untouched test data&lt;br&gt;Measure precision, recall, F1 and ROC-AUC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="550" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="mlflow" value="7. Track with MLflow&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Record data, code, settings, metrics and model artifact&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="730" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="azure" value="8. Azure ML — Later&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Run pipeline, register approved models,&lt;br&gt;deploy, monitor and retrain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="730" width="300" height="100" as="geometry"/>
